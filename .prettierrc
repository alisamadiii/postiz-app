{
  "singleQuote": true,
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "importOrder": [
    "^(react/(.*)$)|^(react$)",
    "^(next/(.*)$)|^(next$)",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@gitroom/nestjs-libraries/(.*)$",
    "^@gitroom/helpers/(.*)$",
    "^@gitroom/react/(.*)$",
    "^@gitroom/frontend/(.*)$",
    "",
    "^[./]"
  ]
}
